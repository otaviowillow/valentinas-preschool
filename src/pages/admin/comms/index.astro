---
export const prerender = false;

import { asc, desc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { dbFrom, schema } from '../../../db';
import { formatDate } from '../../../lib/format';
import { selectAnnouncementRecipients } from '../../../lib/announcements';

const db = dbFrom();
const classList = await db
  .select()
  .from(schema.classes)
  .orderBy(asc(schema.classes.name));
const classMap = new Map(classList.map((c) => [c.id, c.name]));
const recipientRows = await db
  .select({
    email: schema.families.email,
    childStatus: schema.children.status,
    classId: schema.children.classId,
  })
  .from(schema.children)
  .innerJoin(
    schema.families,
    eq(schema.children.familyId, schema.families.id)
  )
  .where(eq(schema.children.status, 'enrolled'));
const allRecipientCount = selectAnnouncementRecipients(recipientRows, null).length;
const classRecipientCounts = new Map(
  classList.map((c) => [
    c.id,
    selectAnnouncementRecipients(recipientRows, c.id).length,
  ])
);

const announcements = await db
  .select()
  .from(schema.announcements)
  .orderBy(desc(schema.announcements.publishedAt));
const clearStoredDraft =
  Astro.url.searchParams.get('flash')?.startsWith('Announcement posted') ?? false;
---

<AdminLayout title="Communications" active="comms">
  <div class="admin-head">
    <div>
      <h1>Communications</h1>
      <p>Draft announcements and email attachments to families.</p>
    </div>
  </div>

  <div class="comms-compose">
    <section class="admin-panel">
      <h2>New announcement</h2>
      <form
        id="announcementForm"
        method="POST"
        action="/api/admin/announcements/"
        class="admin-form"
        enctype="multipart/form-data"
        data-clear-draft={String(clearStoredDraft)}
      >
        <input type="hidden" name="_action" value="create" />
        <input type="hidden" name="_redirect" value="/admin/comms/" />
        <div class="admin-field">
          <label for="title">Title *</label>
          <input id="title" name="title" required />
        </div>
        <div class="admin-field">
          <label for="body">Message *</label>
          <textarea id="body" name="body" rows="5" required></textarea>
        </div>
        <div class="admin-field">
          <span class="dz-label">Attachment (optional)</span>
          <label class="attachment-dropzone" for="announcementAttachment">
            <span class="attachment-empty" id="attachmentEmpty">
              <span class="dz-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-.5-7.97 6 6 0 0 1 11.5-1.2A3.5 3.5 0 0 1 18 18z"/><path d="M12 12v6"/><path d="M9.5 14.5 12 12l2.5 2.5"/></svg>
              </span>
              <span class="dz-title">Choose a file or drag and drop it here</span>
              <span class="dz-hint">Images, PDF, Word, or text (max 10 MB)</span>
              <span class="attachment-browse">Choose file</span>
            </span>
          </label>
          <input
            id="announcementAttachment"
            name="attachment"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif,.pdf,.doc,.docx,.txt,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
            multiple
            data-preview-ready="true"
            hidden
          />
          <div class="attachment-selection" id="attachmentSelection" hidden>
            <strong>Attached files</strong>
            <button type="button" id="attachmentClear">Clear attachments</button>
          </div>
          <div class="attachment-list" id="attachmentList" hidden></div>
        </div>
        <div class="grid2">
          <div class="admin-field">
            <label for="audience">Audience</label>
            <select id="audience" name="audience">
              <option value="all" data-count={allRecipientCount}>
                All enrolled families ({allRecipientCount})
              </option>
              <option value="class">Specific class</option>
            </select>
          </div>
          <div class="admin-field">
            <label for="aclass">Class (if specific)</label>
            <select id="aclass" name="classId" disabled>
              <option value="">—</option>
              {
                classList.map((c) => (
                  <option value={c.id} data-count={classRecipientCounts.get(c.id) ?? 0}>
                    {c.name} ({classRecipientCounts.get(c.id) ?? 0})
                  </option>
                ))
              }
            </select>
          </div>
        </div>
        <p class="muted" id="announcementRecipients">
          {allRecipientCount} enrolled {allRecipientCount === 1 ? 'family' : 'families'} with
          email
        </p>
        <div><button type="submit" class="admin-btn">Send announcement</button></div>
      </form>
    </section>
  </div>

  <section class="admin-panel">
    <h2>Recent announcements</h2>
    {
      announcements.length === 0 ? (
        <p class="muted">No announcements yet.</p>
      ) : (
        <ul class="ann-list">
          {announcements.map((a) => (
            <li>
              <div>
                <strong>{a.title}</strong>
                <span class="muted">
                  {' '}
                  · {formatDate(a.publishedAt)} ·{' '}
                  {a.audience === 'class' && a.classId
                    ? (classMap.get(a.classId) ?? 'Class')
                    : 'All families'}
                </span>
                <p style="white-space:pre-wrap;margin:.35rem 0 0;">{a.body}</p>
              </div>
              <form
                method="POST"
                action="/api/admin/announcements/"
                class="announcement-delete-form"
              >
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={a.id} />
                <input type="hidden" name="_redirect" value="/admin/comms/" />
                <button
                  type="button"
                  class="admin-btn admin-btn--danger admin-btn--sm"
                  data-delete-announcement
                >
                  Delete
                </button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
  </section>

</AdminLayout>

<style>
  .ann-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .ann-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-surface-2);
  }
  .comms-compose {
    width: 100%;
    margin-bottom: 1.25rem;
  }
  .dz-label {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-primary-dark);
    display: block;
    margin-bottom: 0.35rem;
  }
  .attachment-dropzone {
    display: grid;
    border: 2px dashed var(--color-primary-light);
    border-radius: 12px;
    background: var(--admin-card);
    min-height: 12rem;
    padding: 1.25rem;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .attachment-dropzone:hover,
  .attachment-dropzone.is-drag {
    border-color: var(--color-primary);
    background: var(--color-mint);
  }
  .attachment-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    text-align: center;
  }
  .attachment-empty[hidden],
  .attachment-preview[hidden],
  .attachment-preview img[hidden],
  .attachment-file-icon[hidden],
  .attachment-selection[hidden] {
    display: none;
  }
  .dz-icon {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--color-mint);
    color: var(--color-primary);
  }
  .dz-icon svg { width: 1.15rem; height: 1.15rem; }
  .dz-title { font-weight: 800; font-size: 0.9rem; color: var(--color-primary-dark); }
  .dz-hint { font-size: 0.75rem; color: var(--color-ink-muted); }
  .attachment-browse {
    margin-top: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: 9px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
  }
  .attachment-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .attachment-list[hidden] {
    display: none;
  }
  :global(.attachment-item) {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) 2rem;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.75rem;
    min-width: 0;
    min-height: 4.5rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--admin-line-strong);
    border-radius: 12px;
    background: var(--admin-card);
    box-shadow: var(--shadow-sm);
  }
  :global(.attachment-item img) {
    grid-column: 1;
    grid-row: 1 / 3;
    width: 3.25rem;
    height: 3.25rem;
    display: block;
    object-fit: cover;
    border-radius: 8px;
  }
  :global(.attachment-item__icon) {
    grid-column: 1;
    grid-row: 1 / 3;
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--color-mint);
    color: var(--color-primary-dark);
    font-weight: 800;
    font-size: 0.7rem;
  }
  :global(.attachment-item strong),
  :global(.attachment-item small) {
    grid-column: 2;
    display: block;
    min-width: 0;
  }
  :global(.attachment-item strong) {
    grid-row: 1;
    align-self: end;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.attachment-item small) {
    grid-row: 2;
    align-self: start;
    margin-top: 0.15rem;
    color: var(--color-ink-muted);
  }
  :global(.attachment-item button) {
    grid-column: 3;
    grid-row: 1 / 3;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 8px;
    background: var(--color-mint);
    color: var(--color-primary-dark);
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
  }
  .attachment-preview {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .attachment-preview img {
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--admin-line-strong);
  }
  .attachment-file-icon {
    width: 4rem;
    height: 5rem;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--color-mint);
    color: var(--color-primary-dark);
    font-weight: 700;
    font-size: 0.75rem;
  }
  .attachment-meta {
    min-width: 0;
    display: grid;
    gap: 0.25rem;
    text-align: left;
  }
  .attachment-meta strong {
    overflow-wrap: anywhere;
  }
  .attachment-meta span {
    color: var(--color-ink-muted);
    font-size: 0.85rem;
  }
  .attachment-selection {
    margin-top: 0.45rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.85rem;
  }
  .attachment-selection span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .attachment-selection button {
    border: 0;
    background: transparent;
    color: var(--color-secondary-dark);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<script data-astro-rerun>
  const announcementForm = document.getElementById(
    'announcementForm'
  ) as HTMLFormElement | null;
  const audience = document.getElementById('audience') as HTMLSelectElement | null;
  const classSelect = document.getElementById('aclass') as HTMLSelectElement | null;
  const recipientText = document.getElementById('announcementRecipients');
  const titleInput = document.getElementById('title') as HTMLInputElement | null;
  const messageInput = document.getElementById('body') as HTMLTextAreaElement | null;
  const draftKey = 'valentinas-admin-announcement-draft';
  // Attachment previews are initialized by the inline script below.
  const attachmentInput = null as HTMLInputElement | null;
  const attachmentDropzone = document.querySelector('.attachment-dropzone');
  const attachmentEmpty = document.getElementById('attachmentEmpty');
  const attachmentPreview = document.getElementById('attachmentPreview');
  const attachmentSelection = document.getElementById('attachmentSelection');
  const attachmentName = document.getElementById('attachmentName');
  const attachmentSize = document.getElementById('attachmentSize');
  const attachmentThumbnail = document.getElementById(
    'attachmentThumbnail'
  ) as HTMLImageElement | null;
  const attachmentFileIcon = document.getElementById('attachmentFileIcon');
  const attachmentClear = null as HTMLElement | null;
  let attachmentPreviewUrl = '';

  if (announcementForm?.dataset.clearDraft === 'true') {
    localStorage.removeItem(draftKey);
  } else {
    try {
      const draft = JSON.parse(localStorage.getItem(draftKey) ?? 'null');
      if (draft) {
        if (titleInput) titleInput.value = draft.title ?? '';
        if (messageInput) messageInput.value = draft.body ?? '';
        if (audience) audience.value = draft.audience ?? 'all';
        if (classSelect) classSelect.value = draft.classId ?? '';
      }
    } catch {
      localStorage.removeItem(draftKey);
    }
  }

  function saveAnnouncementDraft() {
    localStorage.setItem(
      draftKey,
      JSON.stringify({
        title: titleInput?.value ?? '',
        body: messageInput?.value ?? '',
        audience: audience?.value ?? 'all',
        classId: classSelect?.value ?? '',
      })
    );
  }

  titleInput?.addEventListener('input', saveAnnouncementDraft);
  messageInput?.addEventListener('input', saveAnnouncementDraft);
  audience?.addEventListener('change', saveAnnouncementDraft);
  classSelect?.addEventListener('change', saveAnnouncementDraft);

  function selectedRecipientCount(): number {
    const select = audience?.value === 'class' ? classSelect : audience;
    const option = select?.selectedOptions[0];
    return Number(option?.dataset.count ?? 0);
  }

  function updateAnnouncementAudience() {
    const needsClass = audience?.value === 'class';
    if (classSelect) {
      classSelect.disabled = !needsClass;
      classSelect.required = needsClass;
      if (!needsClass) classSelect.value = '';
    }
    const count = selectedRecipientCount();
    if (recipientText) {
      recipientText.textContent = `${count} enrolled ${
        count === 1 ? 'family' : 'families'
      } with email`;
    }
  }

  audience?.addEventListener('change', updateAnnouncementAudience);
  classSelect?.addEventListener('change', updateAnnouncementAudience);

  function clearAttachment() {
    if (attachmentPreviewUrl) URL.revokeObjectURL(attachmentPreviewUrl);
    attachmentPreviewUrl = '';
    if (attachmentInput) attachmentInput.value = '';
    if (attachmentThumbnail) {
      attachmentThumbnail.removeAttribute('src');
      attachmentThumbnail.hidden = true;
    }
    if (attachmentFileIcon) attachmentFileIcon.hidden = true;
    if (attachmentName) attachmentName.textContent = '';
    if (attachmentSize) attachmentSize.textContent = '';
    if (attachmentEmpty) attachmentEmpty.hidden = false;
    if (attachmentPreview) attachmentPreview.hidden = true;
    if (attachmentSelection) attachmentSelection.hidden = true;
  }

  function showAttachment() {
    if (!attachmentInput) return;
    const file = attachmentInput.files?.[0];
    if (!file) {
      clearAttachment();
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      clearAttachment();
      window.alert('Attachment is too large (max 10 MB).');
      return;
    }
    if (attachmentPreviewUrl) URL.revokeObjectURL(attachmentPreviewUrl);
    attachmentPreviewUrl = '';
    const isImage = file.type.startsWith('image/');
    if (attachmentThumbnail) {
      attachmentThumbnail.hidden = !isImage;
      if (isImage) {
        attachmentPreviewUrl = URL.createObjectURL(file);
        attachmentThumbnail.src = attachmentPreviewUrl;
      }
    }
    if (attachmentFileIcon) {
      attachmentFileIcon.hidden = isImage;
      attachmentFileIcon.textContent =
        file.name.split('.').pop()?.slice(0, 4).toUpperCase() || 'FILE';
    }
    if (attachmentName) attachmentName.textContent = file.name;
    if (attachmentSize) {
      attachmentSize.textContent =
        file.size < 1024 * 1024
          ? `${Math.ceil(file.size / 1024)} KB`
          : `${(file.size / (1024 * 1024)).toFixed(1)} MB`;
    }
    if (attachmentEmpty) attachmentEmpty.hidden = true;
    if (attachmentPreview) attachmentPreview.hidden = false;
    if (attachmentSelection) attachmentSelection.hidden = false;
  }

  attachmentInput?.addEventListener('change', showAttachment);
  attachmentClear?.addEventListener('click', clearAttachment);
  ['dragenter', 'dragover'].forEach((eventName) =>
    attachmentDropzone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      attachmentDropzone.classList.add('is-drag');
    })
  );
  ['dragleave', 'drop'].forEach((eventName) =>
    attachmentDropzone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      attachmentDropzone.classList.remove('is-drag');
    })
  );
  attachmentDropzone?.addEventListener('drop', (event) => {
    const files = (event as DragEvent).dataTransfer?.files;
    if (attachmentInput && files?.length) {
      attachmentInput.files = files;
      showAttachment();
    }
  });
  announcementForm?.addEventListener('submit', (event) => {
    const count = selectedRecipientCount();
    if (!window.confirm(`Email this announcement to ${count} enrolled ${
      count === 1 ? 'family' : 'families'
    }?`)) {
      event.preventDefault();
    }
  });
  document.querySelectorAll<HTMLFormElement>('.announcement-delete-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!window.confirm('Delete this announcement?')) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"], button');
      if (button) button.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(`Delete failed (${response.status})`);
        form.closest('li')?.remove();
      } catch {
        if (button) button.disabled = false;
        window.alert('The announcement could not be deleted. Try again.');
      }
    });
  });
  updateAnnouncementAudience();
</script>

<script is:inline data-astro-rerun>
  document.querySelectorAll('[data-delete-announcement]').forEach((candidate) => {
    if (!(candidate instanceof HTMLButtonElement) || candidate.dataset.deleteBound) return;
    candidate.dataset.deleteBound = 'true';
    candidate.addEventListener('click', async () => {
      const form = candidate.closest('form');
      if (!(form instanceof HTMLFormElement) || !window.confirm('Delete this announcement?')) {
        return;
      }

      candidate.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(`Delete failed (${response.status})`);
        form.closest('li')?.remove();
      } catch {
        candidate.disabled = false;
        window.alert('The announcement could not be deleted. Try again.');
      }
    });
  });
</script>

<script is:inline data-astro-rerun>
  (() => {
    const input = document.getElementById('announcementAttachment');
    const dropzone = document.querySelector('.attachment-dropzone');
    const list = document.getElementById('attachmentList');
    const selection = document.getElementById('attachmentSelection');
    const clear = document.getElementById('attachmentClear');
    if (!(input instanceof HTMLInputElement) || input.dataset.multiPreviewReady) return;
    input.dataset.multiPreviewReady = 'true';

    let files = [];
    let objectUrls = [];

    const syncInput = () => {
      const transfer = new DataTransfer();
      files.forEach((file) => transfer.items.add(file));
      input.files = transfer.files;
    };

    const formatSize = (bytes) =>
      bytes < 1024 * 1024
        ? `${Math.ceil(bytes / 1024)} KB`
        : `${(bytes / (1024 * 1024)).toFixed(1)} MB`;

    const render = () => {
      objectUrls.forEach((url) => URL.revokeObjectURL(url));
      objectUrls = [];
      if (!list) return;
      list.replaceChildren();

      files.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = 'attachment-item';

        if (file.type.startsWith('image/')) {
          const image = document.createElement('img');
          const url = URL.createObjectURL(file);
          objectUrls.push(url);
          image.src = url;
          image.alt = '';
          item.append(image);
        } else {
          const icon = document.createElement('div');
          icon.className = 'attachment-item__icon';
          icon.textContent = file.name.split('.').pop()?.slice(0, 4).toUpperCase() || 'FILE';
          item.append(icon);
        }

        const name = document.createElement('strong');
        name.textContent = file.name;
        name.title = file.name;
        const size = document.createElement('small');
        size.textContent = formatSize(file.size);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.setAttribute('aria-label', `Remove ${file.name}`);
        remove.textContent = '×';
        remove.addEventListener('click', () => {
          files.splice(index, 1);
          syncInput();
          render();
        });
        item.append(name, size, remove);
        list.append(item);
      });

      list.hidden = files.length === 0;
      if (selection) selection.hidden = files.length === 0;
    };

    const addFiles = (incoming) => {
      for (const file of Array.from(incoming)) {
        if (file.size > 10 * 1024 * 1024) {
          window.alert(`${file.name} is too large (max 10 MB).`);
          continue;
        }
        const duplicate = files.some(
          (current) =>
            current.name === file.name &&
            current.size === file.size &&
            current.lastModified === file.lastModified
        );
        if (!duplicate) files.push(file);
      }
      syncInput();
      render();
    };

    input.addEventListener('change', () => addFiles(input.files || []));
    clear?.addEventListener('click', () => {
      files = [];
      syncInput();
      render();
    });
    ['dragenter', 'dragover'].forEach((name) =>
      dropzone?.addEventListener(name, (event) => {
        event.preventDefault();
        dropzone.classList.add('is-drag');
      })
    );
    ['dragleave', 'drop'].forEach((name) =>
      dropzone?.addEventListener(name, (event) => {
        event.preventDefault();
        dropzone.classList.remove('is-drag');
      })
    );
    dropzone?.addEventListener('drop', (event) => {
      const dropped = event.dataTransfer?.files;
      if (dropped?.length) addFiles(dropped);
    });
  })();
</script>

<script is:inline data-astro-rerun>
  (() => {
    const input = document.getElementById('announcementAttachment');
    const empty = document.getElementById('attachmentEmpty');
    const preview = document.getElementById('attachmentPreview');
    const thumbnail = document.getElementById('attachmentThumbnail');
    const fileIcon = document.getElementById('attachmentFileIcon');
    const fileName = document.getElementById('attachmentName');
    const fileSize = document.getElementById('attachmentSize');
    const selection = document.getElementById('attachmentSelection');
    const clear = document.getElementById('attachmentClear');

    if (!(input instanceof HTMLInputElement) || input.dataset.previewReady) return;
    input.dataset.previewReady = 'true';
    let objectUrl = '';

    const reset = () => {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = '';
      input.value = '';
      if (thumbnail instanceof HTMLImageElement) {
        thumbnail.removeAttribute('src');
        thumbnail.setAttribute('hidden', '');
      }
      fileIcon?.setAttribute('hidden', '');
      empty?.removeAttribute('hidden');
      preview?.setAttribute('hidden', '');
      selection?.setAttribute('hidden', '');
    };

    const render = () => {
      const file = input.files?.[0];
      if (!file) return reset();
      if (file.size > 10 * 1024 * 1024) {
        reset();
        window.alert('Attachment is too large (max 10 MB).');
        return;
      }

      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = '';
      const isImage = file.type.startsWith('image/');
      if (thumbnail instanceof HTMLImageElement) {
        if (isImage) {
          objectUrl = URL.createObjectURL(file);
          thumbnail.src = objectUrl;
          thumbnail.removeAttribute('hidden');
        } else {
          thumbnail.setAttribute('hidden', '');
        }
      }
      if (fileIcon) {
        fileIcon.textContent =
          file.name.split('.').pop()?.slice(0, 4).toUpperCase() || 'FILE';
        if (isImage) fileIcon.setAttribute('hidden', '');
        else fileIcon.removeAttribute('hidden');
      }
      if (fileName) fileName.textContent = file.name;
      if (fileSize) {
        fileSize.textContent =
          file.size < 1024 * 1024
            ? `${Math.ceil(file.size / 1024)} KB`
            : `${(file.size / (1024 * 1024)).toFixed(1)} MB`;
      }
      empty?.setAttribute('hidden', '');
      preview?.removeAttribute('hidden');
      selection?.removeAttribute('hidden');
    };

    input.addEventListener('change', render);
    clear?.addEventListener('click', reset);
  })();
</script>
